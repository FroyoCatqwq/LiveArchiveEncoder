<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- No proxy here on purpose: the developer machine that needs one sets
       http_proxy in the user-level config (%APPDATA%\NuGet\NuGet.Config) or in
       the HTTP_PROXY environment variable. Baking a 127.0.0.1 proxy into the
       repository would break restore for everyone else. -->
</configuration>

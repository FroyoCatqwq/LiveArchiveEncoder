<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Local HTTP proxy supplied by the user. The default NuGet route is blocked
       by a 502 tunnel proxy, so every restore goes through 127.0.0.1:10808. -->
  <config>
    <add key="http_proxy" value="http://127.0.0.1:10808" />
  </config>
</configuration>

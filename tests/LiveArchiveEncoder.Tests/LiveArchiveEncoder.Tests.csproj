<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same switch as the app: `dotnet test -p:LaeTfm=net11.0` runs the whole
         suite against the .NET 11 runtime, which is how "supports .NET 10 and
         .NET 11" is proven rather than assumed. -->
    <TargetFramework>$(LaeTfm)</TargetFramework>
    <RootNamespace>LiveArchiveEncoder.Tests</RootNamespace>
    <AssemblyName>LiveArchiveEncoder.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- NUnit 5 (framework 5.x + adapter 6.x). The adapter package is still
         called NUnit3TestAdapter; it is what serves both NUnit 4 and 5. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="NUnit" Version="5.*" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LiveArchiveEncoder\LiveArchiveEncoder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>

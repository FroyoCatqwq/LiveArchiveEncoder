<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same switch as the app: `dotnet test -p:LaeTfm=net11.0` runs the whole
         suite against the .NET 11 runtime, which is how "supports .NET 10 and
         .NET 11" is proven rather than assumed. -->
    <TargetFramework>$(LaeTfm)</TargetFramework>
    <RootNamespace>LiveArchiveEncoder.Tests</RootNamespace>
    <AssemblyName>LiveArchiveEncoder.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TUnit runs on Microsoft.Testing.Platform. The SDK picks that up from
         the test.runner section of global.json, so plain `dotnet test` works;
         the test binary also runs standalone: LiveArchiveEncoder.Tests.exe. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- TUnit 1.75.0: core + engine + assertions in the single package.
         Compile-time discovery, no reflection over the test assembly, and
         `dotnet test` keeps working through the bundled MTP bridge. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="TUnit" Version="1.75.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LiveArchiveEncoder\LiveArchiveEncoder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="TUnit.Assertions" />
  </ItemGroup>

</Project>

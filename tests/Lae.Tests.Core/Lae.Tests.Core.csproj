<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for Lae.Core. These must stay fast: Core is pure, so the whole
    suite should finish in milliseconds and never need a fixture, a temp file or
    an FFmpeg binary. If a test here needs any of those, the code under test is
    in the wrong assembly.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Lae.Tests.Core</RootNamespace>
    <AssemblyName>Lae.Tests.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="TUnit" Version="1.75.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lae.Core\Lae.Core.csproj" />
    <ProjectReference Include="..\..\src\Lae.Media\Lae.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="TUnit.Assertions" />
  </ItemGroup>

</Project>

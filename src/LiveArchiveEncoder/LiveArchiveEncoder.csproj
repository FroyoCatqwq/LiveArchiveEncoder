<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- See Directory.Build.props: $(LaeTfm) is net10.0 by default and can be
         overridden with -p:LaeTfm=net11.0 for a .NET 11-targeted build. -->
    <TargetFramework>$(LaeTfm)</TargetFramework>
    <RootNamespace>LiveArchiveEncoder</RootNamespace>
    <AssemblyName>LiveArchiveEncoder</AssemblyName>

    <!-- Run on the newest installed runtime this major or newer, so a machine
         with only .NET 11 installed still starts the .NET 10 build. This is what
         makes one binary cover "supports .NET 10 and .NET 11". -->
    <RollForward>Major</RollForward>

    <!-- Workstation GC keeps pause times low while feeding raw frames. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <!-- Trim runtime services this tool never uses. All of these are offline
         switches. -->
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <!-- NativeAOT.
       AOT is opt-in so the default `dotnet build` stays a plain JIT app:
       dotnet publish -c Release -r win-x64 -p:PublishAot=true

       What AOT actually buys here: process start drops from the JIT plus
       tiered warm-up cost to a few milliseconds, and the result is one small
       self-contained exe. It does NOT make encoding faster: the encoder runs
       in FFmpeg child processes and the wall clock is pinned by the
       deliberate realtime pacing.

       v7.8.1: there used to be a second AVX2 flavour, built with
       -p:IlcInstructionSet=avx2. It was dropped. The instruction set only
       affects the C# side of this tool, while the encoding itself happens in
       FFmpeg, which runtime-dispatches its own SIMD; the measured difference on
       encode throughput was nil. Two flavours are enough: JIT and AOT. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- Optimise generated code for throughput; also enables the runtime's
         vectorised sort (VxSort) path. -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- Drop the symbol table from the native image. -->
    <StripSymbols>true</StripSymbols>
    <!-- Statically linked, no VC++ redistributable needed. -->
    <StaticallyLinked>true</StaticallyLinked>

    <!-- link.exe needs the Windows SDK import libraries (advapi32.lib,
         ucrt.lib, ...). `vcvarsall.bat` normally supplies them through LIB,
         but its SDK discovery goes through reg.exe, which is blocked in the
         build sandbox used here, so the directories are passed explicitly.
         On a normal developer box this block can be deleted. -->
    <WindowsSdkLibRoot Condition="'$(WindowsSdkLibRoot)' == ''">C:\Program Files (x86)\Windows Kits\10\Lib</WindowsSdkLibRoot>
    <WindowsSdkLibVersion Condition="'$(WindowsSdkLibVersion)' == ''">10.0.26100.0</WindowsSdkLibVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' AND $([MSBuild]::IsOSPlatform('Windows'))">
    <AdditionalNativeLibraryDirectories Include="$(WindowsSdkLibRoot)\$(WindowsSdkLibVersion)\um\x64" />
    <AdditionalNativeLibraryDirectories Include="$(WindowsSdkLibRoot)\$(WindowsSdkLibVersion)\ucrt\x64" />
  </ItemGroup>

  <!-- Linux AOT needs the same idea but different libraries: the toolchain
       resolves libc/libunwind from the system, nothing extra to point at. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' AND !$([MSBuild]::IsOSPlatform('Windows'))">
    <AdditionalNativeLibraryDirectories Include="/usr/lib/x86_64-linux-gnu" />
  </ItemGroup>

  <!-- Keep the GC heap small: this process allocates almost nothing per frame. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Conserve" Value="7" Trim="false" />
  </ItemGroup>

</Project>

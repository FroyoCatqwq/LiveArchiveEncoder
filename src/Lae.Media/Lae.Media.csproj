<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lae.Media — everything that talks to the outside world on the media side:
    FFmpeg discovery, capability probing, process launching, pipe reading,
    remote sources (HTTP/SMB), toolchain download and NNEDI3 weights.

    Depends on Lae.Core only. Knows nothing about encoding policy, commands or
    the console.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Lae.Media</RootNamespace>
    <AssemblyName>Lae.Media</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lae.Core\Lae.Core.csproj" />
  </ItemGroup>

  <!--
    The translation resources travel inside the assembly, not beside it: v8 ships
    as one self-contained file, and a loose locales/ folder would be the first
    thing missing from a user's download. The logical names are pinned so the
    lookup in I18NextMessages does not depend on MSBuild's folder-to-dots rule.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\locales\en\translation.json" LogicalName="lae.locales.en.translation.json" />
    <EmbeddedResource Include="Localization\locales\zh\translation.json" LogicalName="lae.locales.zh.translation.json" />
  </ItemGroup>

  <!--
    Supported Linux baseline: glibc 2.34, i.e. RHEL/AlmaLinux/Rocky 9, Debian
    12, Ubuntu 22.04 and newer. Decided 2026-10-31; v7's 2.17/2.28 floors are
    gone with it. That decision is what lets the SQLite native library be
    current instead of held back for an eight-year-old distribution.

    Why the three lines and not one:

    * Microsoft.Data.Sqlite brings the ADO.NET layer and asks for a
      SQLitePCLRaw core version.
    * SQLitePCLRaw.bundle_e_sqlite3 picks the provider + native pairing.
    * SQLitePCLRaw.lib.e_sqlite3 is the native library itself, and its version
      number tracks SQLite: 3.53.4.1 ships SQLite 3.53.4, which is past the
      3.50.2 fix for CVE-2025-6965 / GHSA-2m69-gcr7-jv3q. Pinned explicitly so
      the engine version appears in the diff when it moves.

    History: 2.1.11 was pinned for glibc 2.28 and shipped SQLite 3.49.1, which
    is the vulnerable one; 2.1.12/2.1.13 needed 2.34; 2.1.14 was the last
    release that kept 2.28 (SQLite 3.54.0). With the floor raised none of that
    matters any more: take the newest.

    Verify a bump inside the AlmaLinux 9 container: tools/ci/al9-build.sh.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.4.1-pre1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="I18Next.Net" Version="2.0.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

</Project>

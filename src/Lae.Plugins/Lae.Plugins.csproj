<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lae.Plugins 鈥?third-party extension protocol. Discovery, handshake, invoke,
    output verification, and the declarative chain the host executes.

    Depends on Lae.Core (the protocol types are part of the public contract) and
    on Lae.Media, for exactly one type: ChildProcess. A plugin is a child
    process, and ProcessesAreOnlyStartedThroughChildProcess forbids spawning any
    other way 鈥?so this reference is forced by that rule, not chosen. The cost is
    that the plugin host also carries Media's TOML, SQLite and download code as a
    transitive dependency; splitting Media to shave that off was considered and
    rejected as not worth two assemblies.

    The arrow points one way: plugins may use Media, Media never learns that
    plugins exist, and neither may reference Lae.Encoding. The pipeline does not
    know what a plugin is; the host hands it finished hops.

    Plugins are separate processes in any language; nothing is loaded in-proc,
    so a crashing plugin costs one exit code, not the whole encode.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Lae.Plugins</RootNamespace>
    <AssemblyName>Lae.Plugins</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lae.Core\Lae.Core.csproj" />
    <ProjectReference Include="..\Lae.Media\Lae.Media.csproj" />
  </ItemGroup>

</Project>

